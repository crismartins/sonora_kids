{
  "expo": {
    "name": "Sonora Kids",
    "slug": "sonora-kids",
    "scheme": "sonora-kids",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sonorakids.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2567FF"
      },
      "package": "com.sonorakids.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2567FF",
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Sonora Kids usa suas fotos para o perfil e para criar PECs personalizados.",
          "cameraPermission": "O Sonora Kids usa a câmera para a foto do perfil e dos PECs.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
